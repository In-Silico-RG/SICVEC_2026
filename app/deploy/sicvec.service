[Unit]
Description=SICVEC 2026 management app (gunicorn)
After=network.target

[Service]
User=sicvec
Group=sicvec
WorkingDirectory=/opt/sicvec/app
EnvironmentFile=/etc/sicvec/sicvec.env
ExecStart=/opt/sicvec/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --timeout 30 run:app
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sicvec
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
